<Window x:Class="CybersecurityChatbot_Part3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" 
        Height="700" Width="1000"
        Background="#1a1a2e"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#16213e" Margin="10" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="CYBERSECURITY AWARENESS BOT" 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="Cyan"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Keeping You Safe Online" 
                               FontSize="14" 
                               Foreground="LightGray"
                               HorizontalAlignment="Center"/>

                    <!-- Buttons for extra features -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Margin="0,10,0,0">
                        <Button Content="Add Task" 
                                Click="AddTask_Click"
                                Background="Cyan" 
                                Foreground="Black"
                                FontWeight="Bold" 
                                Margin="5,0,5,0" 
                                Padding="10,5"/>
                        <Button Content="View Tasks" 
                                Click="ViewTasks_Click"
                                Background="Cyan" 
                                Foreground="Black"
                                FontWeight="Bold" 
                                Margin="5,0,5,0" 
                                Padding="10,5"/>
                        <Button Content="Activity Log" 
                                Click="ActivityLog_Click"
                                Background="Cyan" 
                                Foreground="Black"
                                FontWeight="Bold" 
                                Margin="5,0,5,0" 
                                Padding="10,5"/>
                        <Button Content="Quiz Me!" 
                                Click="Quiz_Click"
                                Background="LimeGreen" 
                                Foreground="Black"
                                FontWeight="Bold" 
                                Margin="5,0,5,0" 
                                Padding="10,5"/>
                    </StackPanel>
                </StackPanel>

                <!-- Image -->
                <Image Source="/logo.jpg"
                       Width="120" Height="120"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Grid.Column="1"
                       Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- Chat area -->
        <Border Grid.Row="1" Background="#0f3460" Margin="10" CornerRadius="10">
            <ScrollViewer x:Name="chatScroller" 
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatPanel" Margin="10"/>
            </ScrollViewer>
        </Border>

        <!-- Input area -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="userInput" 
                     Height="45" 
                     FontSize="16"
                     KeyDown="UserInput_KeyDown"
                     Background="#16213e" 
                     Foreground="White"
                     CaretBrush="White"
                     BorderBrush="Cyan"
                     BorderThickness="2"
                     Padding="10"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="sendButton"
                    Click="SendButton_Click"
                    Content="Send" 
                    Height="45" 
                    Grid.Column="1" 
                    Width="110"
                    Background="Cyan" 
                    Foreground="Black"
                    FontWeight="Bold"
                    FontSize="14"
                    VerticalAlignment="Center"
                    Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</Window>