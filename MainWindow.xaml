<Window x:Class="ChatSecurityChatBot_2.MainWindow"
        Loaded="Window_Loaded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" 
        Height="600" Width="900"
        Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Header with logo and image -->
        <Border Grid.Row="0" Background="#16213e" Margin="10" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text=" CYBERSECURITY AWARENESS BOT " 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="Cyan"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Keeping You Safe Online" 
                               FontSize="14" 
                               Foreground="LightGray"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Image in top right corner -->
                <Image
                       Source="/logo.jpg"
                       Width="200" 
                       Height="180"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" Grid.Column="1" RenderTransformOrigin="0.701,0.509" Margin="45,0,0,0"/>
            </Grid>
        </Border>

        <!-- Chat area -->
        <Border Grid.Row="1" Background="#0f3460" Margin="10" CornerRadius="10">
            <ScrollViewer x:Name="chatScroller" 
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatPanel" Margin="10"/>
            </ScrollViewer>
        </Border>

        <!-- Input area -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="userInput" 
                     Height="45" FontSize="16"
                     KeyDown="userInput_KeyDown"
                     Background="#16213e" 
                     Foreground="White"
                     CaretBrush="White"
                     BorderBrush="Cyan"
                     BorderThickness="2"
                     Padding="10"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="sendButton"
                    Click="sendButton_Click"
                    Content="Send " 
                    Height="45" 
                    Grid.Column="1" 
                    Width="110"
                    Background="GhostWhite" 
                    Foreground="Black"
                    FontWeight="Bold"
                    FontSize="14"
                    VerticalAlignment="Center"
                    Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</Window>